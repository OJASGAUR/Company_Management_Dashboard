# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js secret (generate a long random value for production)
AUTH_SECRET="replace-with-a-long-random-secret"

# Public application URL used by Auth.js callbacks
NEXTAUTH_URL="http://localhost:3000"

# 32-byte AES key encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="replace-with-64-hex-characters"
