// Company Management Dashboard — PostgreSQL Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  DIRECTOR
  HR
  OPERATIONS_MANAGER
  TEAM_LEAD
  DEVELOPER
  DESIGNER
  TESTER
  ACCOUNTS
  EMPLOYEE
  CLIENT
}

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              Role     @default(EMPLOYEE)
  department        String?
  designation       String?
  joiningDate       DateTime?
  employeeId        String?  @unique
  isActive          Boolean  @default(true)
  onboardingStatus  String   @default("IN_PROGRESS")
  companyEmail      String?
  phone             String?
  personalEmail     String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  city              String?
  state             String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?
  education         String?
  experience        String?
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  bankIfsc          String?
  upiId             String?
  resumeUrl         String?
  offerLetterUrl    String?
  certificatesUrl   String?
  idProofUrl        String?
  photoUrl          String?
  managerId         String?

  accounts          Account[]
  sessions          Session[]
  attendances       Attendance[]
  leaves            Leave[]
  tasks             Task[]           @relation("AssignedTasks")
  assignedTasks     Task[]           @relation("AssignedBy")
  timeLogs          TimeLog[]
  sentMessages      Message[]        @relation("SentMessages")
  receivedMessages  Message[]        @relation("ReceivedMessages")
  assignedAssets    Asset[]          @relation("AssignedAssets")
  manager           User?            @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports     User[]           @relation("ManagerReports")
  notifications     Notification[]
  auditLogs         AuditLog[]       @relation("AuditActor")
  permissions       UserPermission[]
  createdGroups     MessageGroup[]   @relation("CreatedGroups")
  groupMemberships  MessageGroupMember[]
  createdOfferTemplates OfferLetterTemplate[]
  createdBackups    BackupSnapshot[] @relation("CreatedBackups")

  emailTasks         Boolean @default(true)
  emailLeaves        Boolean @default(true)
  emailAnnouncements Boolean @default(true)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([department])
  @@index([role])
  @@index([managerId])
  @@index([isActive])
  @@index([dateOfBirth])
  @@index([joiningDate])
}

model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  permission  String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, permission])
  @@index([permission, enabled])
}

model Attendance {
  id String @id @default(cuid())
  userId String
  date DateTime
  checkIn DateTime
  checkOut DateTime?
  status String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, date])
}

model Leave {
  id String @id @default(cuid())
  userId String
  type String
  startDate DateTime
  endDate DateTime
  status String
  reason String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startDate])
  @@index([status])
}

model Project {
  id String @id @default(cuid())
  name String
  description String?
  clientName String?
  status String
  startDate DateTime?
  endDate DateTime?
  tasks Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([clientName])
  @@index([status])
}

model Task {
  id String @id @default(cuid())
  projectId String?
  userId String
  assignedById String?
  title String
  description String?
  priority String
  deadline DateTime?
  status String
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user User @relation("AssignedTasks", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  timeLogs TimeLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
  @@index([projectId])
  @@index([title])
  @@index([priority])
}

model TimeLog {
  id String @id @default(cuid())
  taskId String
  userId String
  startTime DateTime
  endTime DateTime?
  duration Int?
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startTime])
  @@index([taskId])
}

model Message {
  id String @id @default(cuid())
  senderId String
  receiverId String?
  groupId String?
  content String
  attachmentUrl String?
  attachmentName String?
  timestamp DateTime @default(now())
  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  group MessageGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  @@index([senderId, timestamp])
  @@index([receiverId, timestamp])
  @@index([groupId, timestamp])
}

model MessageGroup {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  members     MessageGroupMember[]
  messages    Message[]
  @@index([createdById])
}

model MessageGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime     @default(now())
  group     MessageGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([userId])
}

model Event {
  id String @id @default(cuid())
  title String
  description String?
  date DateTime
  type String
  createdAt DateTime @default(now())
  @@index([date])
}

model Asset {
  id String @id @default(cuid())
  name String
  type String
  status String
  assignedToId String?
  assignedTo User? @relation("AssignedAssets", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([assignedToId])
}

model Invoice {
  id String @id @default(cuid())
  clientId String?
  amount Float
  gstRate Float @default(18)
  status String
  dueDate DateTime
  createdAt DateTime @default(now())
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  payments Payment[]
  @@index([clientId])
  @@index([status, dueDate])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  status    String
  paidAt    DateTime?
  reference String?
  notes     String?
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId, paidAt])
  @@index([status])
}

model Client {
  id String @id @default(cuid())
  name String
  company String
  email String
  phone String?
  createdAt DateTime @default(now())
  files FileRecord[]
  invoices Invoice[]
  @@index([company])
  @@index([email])
  @@index([name])
}

model Domain {
  id String @id @default(cuid())
  url String
  provider String
  expiryDate DateTime
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([expiryDate])
  @@index([url])
  @@index([status])
}

model FileRecord {
  id String @id @default(cuid())
  fileName String
  fileUrl String
  size Int
  uploaderId String
  clientId String?
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([uploaderId, createdAt])
  @@index([clientId, createdAt])
  @@index([fileName])
}

model Notification {
  id String @id @default(cuid())
  userId String
  title String
  body String
  type String @default("INFO")
  link String?
  dedupeKey String? @unique
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model OfferLetterTemplate {
  id          String   @id @default(cuid())
  name        String
  content     String
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  @@index([isActive])
}

model BackupSnapshot {
  id          String   @id @default(cuid())
  period      String   @unique
  format      String   @default("JSON")
  data        Json
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("CreatedBackups", fields: [createdById], references: [id], onDelete: SetNull)
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}

model CalendarEvent {
  id               String   @id @default(cuid())
  title            String
  description      String?
  category         String   @default("team_meeting")
  startTime        DateTime
  endTime          DateTime?
  allDay           Boolean  @default(false)
  location         String?
  isRecurring      Boolean  @default(false)
  recurrenceRule   String?
  metadata         String?
  createdBy        String?
  externalProvider String?
  externalEventId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([startTime])
  @@index([category])
}

model CalendarIntegration {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  accessToken        String
  refreshToken       String?
  tokenExpiresAt     DateTime?
  externalCalendarId String?
  connectedAt        DateTime @default(now())
  @@index([userId])
}
