// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  DIRECTOR
  HR
  OPERATIONS_MANAGER
  TEAM_LEAD
  DEVELOPER
  DESIGNER
  TESTER
  ACCOUNTS
  EMPLOYEE
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  
  // Custom RBAC & Employee fields
  role          Role      @default(EMPLOYEE)
  department    String?
  designation   String?
  joiningDate   DateTime?
  employeeId    String?   @unique
  
  accounts      Account[]
  sessions      Session[]
  attendances   Attendance[]
  leaves        Leave[]
  tasks         Task[]    @relation("AssignedTasks")
  assignedTasks Task[]    @relation("AssignedBy")
  timeLogs      TimeLog[]
  
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  assignedAssets Asset[]  @relation("AssignedAssets")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime
  checkIn   DateTime
  checkOut  DateTime?
  status    String    @default("PRESENT") // PRESENT, LATE, HALF_DAY
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Leave {
  id        String    @id @default(cuid())
  userId    String
  type      String    // CASUAL, SICK, PAID, LOSS_OF_PAY
  startDate DateTime
  endDate   DateTime
  status    String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reason    String
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  clientName  String?
  status      String    @default("ACTIVE") // PLANNING, ACTIVE, ON_HOLD, COMPLETED
  startDate   DateTime?
  endDate     DateTime?
  
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  projectId   String?
  userId      String    // Assigned to
  assignedById String?  // Assigned by
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  deadline    DateTime?
  status      String    @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, COMPLETED
  
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user        User      @relation("AssignedTasks", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User?     @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  timeLogs    TimeLog[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TimeLog {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startTime DateTime
  endTime   DateTime?
  duration  Int?      // Duration in minutes
  
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  receiverId  String?
  groupId     String?
  content     String
  timestamp   DateTime  @default(now())

  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User?     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        String    @default("MEETING") // MEETING, HOLIDAY, BIRTHDAY
  
  createdAt   DateTime  @default(now())
}

model Asset {
  id          String    @id @default(cuid())
  name        String
  type        String    // LAPTOP, MONITOR, MOBILE
  status      String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, REPAIR
  assignedToId String?
  
  assignedTo  User?     @relation("AssignedAssets", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Invoice {
  id          String    @id @default(cuid())
  clientId    String?
  amount      Float
  status      String    @default("UNPAID") // UNPAID, PAID, OVERDUE
  dueDate     DateTime
  
  createdAt   DateTime  @default(now())
}

model Client {
  id          String    @id @default(cuid())
  name        String
  company     String
  email       String
  phone       String?
  
  createdAt   DateTime  @default(now())
}

model Domain {
  id          String    @id @default(cuid())
  url         String
  provider    String
  expiryDate  DateTime
  status      String    @default("ACTIVE") // ACTIVE, EXPIRED
  
  createdAt   DateTime  @default(now())
}

model FileRecord {
  id          String    @id @default(cuid())
  fileName    String
  fileUrl     String
  size        Int
  uploaderId  String
  
  createdAt   DateTime  @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
